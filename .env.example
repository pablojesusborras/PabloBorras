# ════════════════════════════════════════════════════════════
# Variables de Entorno — Pablo Borrás
# ════════════════════════════════════════════════════════════
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA subas el archivo .env a Git (ya está en .gitignore)

# ────────────────────────────────────────────────────────────
# SANITY CMS
# ────────────────────────────────────────────────────────────
# Obtén estas credenciales desde https://www.sanity.io/manage
#
# PROJECT_ID: ID de tu proyecto de Sanity
# DATASET: Nombre del dataset (normalmente "production")
# API_TOKEN: Token de API con permisos de Editor
#
# Estas variables son necesarias para:
# - El sitio web (leer eventos desde Sanity)
# - El script de migración (subir eventos a Sanity)

PUBLIC_SANITY_PROJECT_ID=tu-project-id-aqui
PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=tu-token-de-api-aqui

# ────────────────────────────────────────────────────────────
# WEB3FORMS (Formulario de contacto)
# ────────────────────────────────────────────────────────────
# Obtén tu access key desde https://web3forms.com

PUBLIC_WEB3FORMS_ACCESS_KEY=tu-access-key-aqui

# ────────────────────────────────────────────────────────────
# GOOGLE ANALYTICS 4 (Opcional)
# ────────────────────────────────────────────────────────────
# Obtén tu ID desde Google Analytics
# Si no está configurado, el script de GA4 no se cargará

PUBLIC_GA4_ID=

# ────────────────────────────────────────────────────────────
# GOOGLE SEARCH CONSOLE (Opcional)
# ────────────────────────────────────────────────────────────
# Código de verificación de Google Search Console
# Si no está configurado, la meta tag no se incluirá

PUBLIC_GSC_VERIFICATION=
