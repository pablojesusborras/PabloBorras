---
// Footer.astro — Pie de página global
---

<footer style="background: var(--color-neutral-dark);" class="pt-10 md:pt-16 pb-6 relative">
  <!-- Línea de acento en el top (igual que el header) -->
  <div
    aria-hidden="true"
    style="
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, #040d4e 0%, #1880c9 50%, #5ba8e0 100%);
    "
  ></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Grid de 2 columnas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10 pb-10 md:pb-12 border-b" style="border-color: rgba(255, 255, 255, 0.1);">

      <!-- Columna 1: Logo + tagline -->
      <div class="text-center md:text-left">
        <a href="/" class="footer-brand-lockup inline-flex items-center gap-3 mb-5" style="text-decoration: none;">
          <img
            src="/imagenes/logo/log2.webp"
            alt="Pablo Borrás Veterinario"
            class="footer-logo w-auto"
            style="height: 56px; display: block; filter: brightness(0) invert(1);"
            loading="lazy"
          />
          <span class="footer-logo-separator" aria-hidden="true"></span>
          <span class="footer-logo-name">Pablo Borrás</span>
        </a>
        <p class="max-w-xs mx-auto md:mx-0 text-sm leading-relaxed mb-6" style="color: rgba(255, 255, 255, 0.75);">
          Médico Veterinario · Speaker · Autor.<br />
          Formación, referencia clínica y marca profesional al servicio del ecosistema veterinario.
        </p>
        <!-- Redes sociales -->
        <div class="flex justify-center md:justify-start gap-3">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/pablojborras"
            aria-label="Instagram de Pablo Borrás"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-all hover:scale-110 inline-flex items-center justify-center rounded-full"
            style="background: rgba(255, 255, 255, 0.1); color: white; width: 40px; height: 40px; backdrop-filter: blur(10px);"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
          </a>
          <!-- YouTube -->
          <a
            href="https://www.youtube.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube de Pablo Borrás"
            class="transition-all hover:scale-110 inline-flex items-center justify-center rounded-full"
            style="background: rgba(255, 255, 255, 0.1); color: white; width: 40px; height: 40px; backdrop-filter: blur(10px);"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.97C18.88 4 12 4 12 4s-6.88 0-8.59.45A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.4a2.78 2.78 0 0 0 1.95-1.97A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
              <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/pablojborras"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn de Pablo Borrás"
            class="transition-all hover:scale-110 inline-flex items-center justify-center rounded-full"
            style="background: rgba(255, 255, 255, 0.1); color: white; width: 40px; height: 40px; backdrop-filter: blur(10px);"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Contacto directo -->
      <div class="text-center md:text-right md:justify-self-end md:self-center">
        <h3
          class="text-white font-bold text-sm uppercase tracking-wider mb-5"
          style="font-family: var(--font-display); letter-spacing: 0.08em;"
        >
          Contacto directo
        </h3>
        <p class="text-sm mb-4 leading-relaxed" style="color: rgba(255, 255, 255, 0.7);">
          ¿Tenés una consulta o propuesta profesional?
        </p>
        <a
          href="mailto:consultas.borras@gmail.com"
          class="text-sm font-semibold transition-colors hover:text-white inline-flex items-center gap-1 mb-6 group md:justify-end"
          style="color: var(--color-accent-light); text-decoration: none;"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span class="transition-all group-hover:underline">consultas.borras@gmail.com</span>
        </a>
        <div class="mt-5">
          <a
            href="/contacto"
            class="block w-full md:inline-block md:w-auto text-sm font-semibold px-6 py-3 rounded-lg transition-all hover:scale-105"
            style="background: var(--color-accent); color: #fff; text-decoration: none; box-shadow: 0 4px 14px rgba(24, 128, 201, 0.4);"
          >
            Formulario de contacto →
          </a>
        </div>
      </div>

    </div>

    <!-- Banda inferior: Copyright, enlaces legales y DevCraft -->
    <div class="pt-4 pb-5 md:py-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-1.5 md:gap-6">
        <p class="text-xs" style="color: rgba(255, 255, 255, 0.5);">
          © {new Date().getFullYear()} Pablo Borrás · Todos los derechos reservados.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/privacidad"
            class="text-xs transition-colors hover:text-white"
            style="color: rgba(255, 255, 255, 0.4); text-decoration: none;"
          >
            Política de Privacidad
          </a>
          <span class="text-xs" style="color: rgba(255, 255, 255, 0.3);">·</span>
          <a
            href="/terminos"
            class="text-xs transition-colors hover:text-white"
            style="color: rgba(255, 255, 255, 0.4); text-decoration: none;"
          >
            Términos y Condiciones
          </a>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-xs" style="color: rgba(255, 255, 255, 0.4);">
            Desarrollado por
          </span>
          <a
            href="https://www.devcraft.com.ar/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs font-semibold transition-all hover:scale-105"
            style="color: rgba(255, 255, 255, 0.7); text-decoration: none;"
          >
            <img 
              src="/imagenes/logo/logodevcraft.png" 
              alt="DevCraft" 
              style="height: 18px; width: auto; opacity: 0.85;"
              class="transition-opacity hover:opacity-100"
            />
            <span class="hover:text-white">DevCraft</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-logo {
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.3s ease;
    filter: brightness(0) invert(1) drop-shadow(0 0 15px rgba(255, 255, 255, 0.3));
  }

  .footer-brand-lockup:hover .footer-logo {
    transform: scale(1.08) translateY(-2px);
    filter: brightness(0) invert(1) drop-shadow(0 0 25px rgba(255, 255, 255, 0.6)) drop-shadow(0 0 40px rgba(24, 128, 201, 0.4));
  }

  .footer-logo-separator {
    width: 1px;
    height: 30px;
    background: rgba(255, 255, 255, 0.35);
  }

  .footer-logo-name {
    color: white;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
  }
</style>
