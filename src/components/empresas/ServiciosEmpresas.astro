---
// ServiciosEmpresas.astro — Servicios institucionales para empresas y organizaciones
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';

const servicios = [
  {
    icon: `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
      <circle cx="9" cy="7" r="4"/>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
      <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
    </svg>`,
    titulo: 'Charlas y conferencias institucionales',
    descripcion: 'Keynotes y presentaciones científicas para congresos, jornadas veterinarias y eventos corporativos. Contenido adaptado al público, con nivel académico y capacidad de comunicación masiva.',
    cta: '/contacto?tab=empresas',
  },
  {
    icon: `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
    </svg>`,
    titulo: 'Capacitaciones para equipos veterinarios',
    descripcion: 'Programas de formación continua diseñados para grupos de trabajo: clínicas, pet shops con asesoría veterinaria, laboratorios y distribuidoras de productos veterinarios.',
    cta: '/contacto?tab=empresas',
  },
  {
    icon: `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
      <line x1="8" y1="21" x2="16" y2="21"/>
      <line x1="12" y1="17" x2="12" y2="21"/>
    </svg>`,
    titulo: 'Contenido educativo y comunicación científica',
    descripcion: 'Producción de contenidos escritos, audiovisuales y digitales con rigor científico y lenguaje accesible. Ideal para marcas de alimentos, productos veterinarios y campañas de salud animal.',
    cta: '/contacto?tab=empresas',
  },
  {
    icon: `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <line x1="12" y1="8" x2="12" y2="12"/>
      <line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>`,
    titulo: 'Proyectos de colaboración y consultoría',
    descripcion: 'Asesoría estratégica en comunicación veterinaria, desarrollo de programas educativos y proyectos de impacto en bienestar animal para instituciones públicas o privadas.',
    cta: '/contacto?tab=empresas',
  },
];
---

<section class="py-20 bg-white" id="servicios">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Título de sección mejorado -->
    <div class="text-center mb-12 md:mb-14">
      <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
        Servicios corporativos
      </p>
      <h2 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;">
        Propuestas para empresas e instituciones
      </h2>
      <div class="w-20 h-1 mx-auto rounded-full" style="background: linear-gradient(90deg, #1880c9 0%, #4a3d9e 100%);"></div>
      <p class="text-base md:text-lg leading-relaxed mt-6 max-w-3xl mx-auto" style="color: var(--color-text-muted);">
        Pablo Borrás colabora con laboratorios, clínicas veterinarias, facultades, organizaciones de bienestar animal e industria de alimentos para mascotas. Sumá autoridad científica y expertise clínico a tu proyecto.
      </p>
    </div>

    <!-- Grid de servicios mejorado -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mb-16 md:mb-20 items-stretch">
      {servicios.map((servicio, index) => {
        // Alternar colores entre celeste y violeta
        const cardColor = index % 2 === 0 ? '#1880c9' : '#4a3d9e';
        const gradientBg = index % 2 === 0 
          ? 'linear-gradient(135deg, rgba(24,128,201,0.05) 0%, transparent 100%)'
          : 'linear-gradient(135deg, rgba(74,61,158,0.05) 0%, transparent 100%)';
        
        return (
          <div
            class="bg-white rounded-2xl p-6 md:p-8 flex flex-col relative overflow-hidden transition-all duration-300 h-full"
            style={`box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-top: 4px solid ${cardColor};`}
            onmouseover={`this.style.transform='translateY(-8px)'; this.style.boxShadow='0 12px 32px rgba(0,0,0,0.12)'`}
            onmouseout={`this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 20px rgba(0,0,0,0.08)'`}
          >
            <!-- Gradiente de fondo -->
            <div
              style={`position: absolute; inset: 0; background: ${gradientBg}; pointer-events: none;`}
              aria-hidden="true"
            ></div>

            <div style="position: relative; z-index: 1; display: flex; flex-direction: column; height: 100%;">
              <!-- Ícono decorativo mejorado -->
              <div 
                class="w-14 h-14 md:w-16 md:h-16 flex items-center justify-center rounded-2xl mb-5 md:mb-6" 
                style={`background: ${index % 2 === 0 ? 'rgba(24,128,201,0.12)' : 'rgba(74,61,158,0.12)'}; border: 2px solid ${index % 2 === 0 ? 'rgba(24,128,201,0.2)' : 'rgba(74,61,158,0.2)'};`}
              >
                <div style={`color: ${cardColor};`} set:html={servicio.icon} />
              </div>

              <!-- Título -->
              <h3
                class="text-lg md:text-xl font-bold mb-3 md:mb-4"
                style="font-family: var(--font-display); color: var(--color-text); line-height: 1.3;"
              >
                {servicio.titulo}
              </h3>

              <!-- Descripción -->
              <p class="text-sm md:text-base leading-relaxed mb-5 md:mb-6" style="color: var(--color-text-muted); flex-grow: 1;">
                {servicio.descripcion}
              </p>

              <!-- CTA mejorado -->
              <a
                href={servicio.cta}
                class="inline-flex items-center gap-2 text-sm font-bold transition-all hover:gap-3"
                style={`color: ${cardColor}; text-decoration: none;`}
              >
                Consultar
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Sección de logos mejorada -->
    <div class="p-8 md:p-12 rounded-3xl relative overflow-hidden" style="background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%); border: 1px solid rgba(24,128,201,0.1);">
      <!-- Decoración de fondo -->
      <div
        style="
          position: absolute;
          inset: 0;
          background-image: radial-gradient(circle at 2px 2px, rgba(24,128,201,0.06) 1px, transparent 0);
          background-size: 30px 30px;
          opacity: 0.4;
        "
        aria-hidden="true"
      ></div>

      <div style="position: relative; z-index: 1;">
        <div class="flex items-center justify-center gap-3 mb-8 md:mb-10">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background: rgba(24,128,201,0.12); border: 2px solid rgba(24,128,201,0.2);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1880c9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <p
            class="text-sm font-bold uppercase tracking-widest text-center"
            style="color: #1880c9;"
          >
            Empresas e instituciones con las que trabajé
          </p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 md:gap-5">
          {['IDEXX', 'Boehringer Ingelheim', 'Royal Canin', 'WAAVP', 'TroCCAP'].map((nombre, idx) => (
            <div
              class="h-28 md:h-32 rounded-2xl flex flex-col items-center justify-center text-center gap-3 px-4 transition-all duration-300"
              style="background: white; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border: 2px solid rgba(24,128,201,0.1);"
              onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 24px rgba(0,0,0,0.12)'; this.style.borderColor='rgba(24,128,201,0.3)'"
              onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 12px rgba(0,0,0,0.06)'; this.style.borderColor='rgba(24,128,201,0.1)'"
            >
              <div
                class="w-9 h-9 rounded-full flex items-center justify-center font-bold"
                style={`background: ${idx % 2 === 0 ? 'rgba(24,128,201,0.12)' : 'rgba(74,61,158,0.12)'}; color: ${idx % 2 === 0 ? '#1880c9' : '#4a3d9e'}; font-size: 13px;`}
                aria-hidden="true"
              >
                {nombre.charAt(0)}
              </div>
              <span style="color: #4b5568; font-size: 12px; font-weight: 700; letter-spacing: 0.03em; line-height: 1.3;">{nombre}</span>
            </div>
          ))}
        </div>

        <p class="text-center text-sm mt-8 md:mt-9 max-w-2xl mx-auto" style="color: var(--color-text-muted);">
          Colaboraciones en congresos, capacitaciones corporativas, proyectos de comunicación y desarrollo de contenidos científicos.
        </p>

        <!-- CTA integrado al bloque de empresas -->
        <div class="text-center mt-8 md:mt-9 pt-8 md:pt-9" style="border-top: 1px solid rgba(24,128,201,0.15);">
          <a
            href="/contacto?tab=empresas"
            class="inline-flex items-center gap-3 px-8 py-4 text-base font-bold rounded-xl transition-all"
            style="
              background: linear-gradient(135deg, #1880c9 0%, #4a3d9e 100%);
              color: white;
              text-decoration: none;
              box-shadow: 0 4px 20px rgba(24,128,201,0.3);
            "
            onmouseover="this.style.transform='translateY(-3px) scale(1.02)'; this.style.boxShadow='0 12px 32px rgba(24,128,201,0.4)'"
            onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 20px rgba(24,128,201,0.3)'"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            Hablemos de tu proyecto
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
          <p class="text-sm mt-4" style="color: var(--color-text-muted);">
            Respuesta en menos de 48 horas hábiles
          </p>
        </div>
      </div>
    </div>

  </div>
</section>
