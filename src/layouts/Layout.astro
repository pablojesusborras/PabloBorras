---
// Layout.astro — Plantilla base para todas las páginas
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import { SITE_CONFIG } from '../config/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  heroImage?: string;
}

const {
  title,
  description = 'Pablo Borrás — Médico Veterinario MSc, especialista en enfermedades infecciosas y parasitarias de perros y gatos. Speaker internacional, autor y docente. Buenos Aires, Argentina.',
  image = '/og-image.jpg',
  type = 'website',
  noindex = false,
  heroImage,
} = Astro.props;

const SITE_URL = SITE_CONFIG.url;
// Canonical sin barra final (excepto la home que es solo /)
const pathname = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonicalURL = `${SITE_URL}${pathname}`;

const ogImage = `${SITE_URL}${image}`;
const fullTitle = title.includes('Pablo Borrás') ? title : `${title} | Pablo Borrás`;

// Solo precargar imágenes del Hero en páginas que lo usan
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const hasHero = currentPath === '/';
const hasSobrePabloHero = currentPath === '/sobre-pablo';

// Identificador único de la entidad Person para el grafo JSON-LD
const personId = `${SITE_URL}#pablo-borras`;

// Determinar qué schema renderizar según la página
const isHomePage = currentPath === '/';
const isSobrePabloPage = currentPath === '/sobre-pablo';
const isLibroPage = currentPath === '/veterinarios/libro';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO básico -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_CONFIG.fullName} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Keywords -->
    <meta name="keywords" content="pablo borras veterinario, infectologia canina, enfermedades parasitarias perros, speaker veterinario argentina, interconsultas veterinarias, capacitaciones veterinarias, enfermedades vectoriales perros, pablo borras infectologo" />

    <!-- Open Graph — Facebook, WhatsApp, LinkedIn -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Pablo Borrás — Veterinario" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pablo Borrás — Médico Veterinario, Speaker y Autor" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:locale:alternate" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Pablo Borrás — Médico Veterinario, Speaker y Autor" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Geo / Local SEO -->
    <meta name="geo.region" content="AR-C" />
    <meta name="geo.placename" content="Buenos Aires, Argentina" />
    <meta name="language" content="Spanish" />

    <!-- Preconnects para performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Preload imágenes críticas del hero (LCP) — solo en páginas con Hero -->
    {hasHero && (
      <>
        <link rel="preload" as="image" href="/imagenes/heros/heropa.webp" media="(min-width: 768px)" fetchpriority="high" />
        <link rel="preload" as="image" href="/imagenes/heros/heromob2.webp" media="(max-width: 767px)" fetchpriority="high" />
      </>
    )}
    {hasSobrePabloHero && (
      <link rel="preload" as="image" href="/imagenes/perfil/pablo3.webp" fetchpriority="high" />
    )}
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}

    <!-- Google Search Console Verification (solo si está configurado) -->
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}

    <!-- Google Analytics 4 (solo si está configurado) -->
    {import.meta.env.PUBLIC_GA4_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA4_ID}`}></script>
        <script define:vars={{ ga4Id: import.meta.env.PUBLIC_GA4_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}

    <!-- JSON-LD — Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        // WebSite - En todas las páginas
        {
          "@type": "WebSite",
          "@id": `${SITE_URL}#website`,
          "url": SITE_URL,
          "name": SITE_CONFIG.name,
          "inLanguage": "es-AR",
          "publisher": { "@id": personId },
        },
        // Person - Entidad principal en todas las páginas
        {
          "@type": "Person",
          "@id": personId,
          "name": SITE_CONFIG.fullName,
          "alternateName": SITE_CONFIG.alternateNames,
          "url": SITE_URL,
          "image": `${SITE_URL}${SITE_CONFIG.profileImage}`,
          "jobTitle": SITE_CONFIG.jobTitle,
          "description": SITE_CONFIG.description,
          "nationality": {
            "@type": "Country",
            "name": SITE_CONFIG.location.country,
          },
          "workLocation": {
            "@type": "Place",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": SITE_CONFIG.location.city,
              "addressCountry": SITE_CONFIG.location.countryCode,
            },
          },
          "sameAs": SITE_CONFIG.socialProfiles,
          "alumniOf": SITE_CONFIG.alumniOf.map(school => ({
            "@type": "CollegeOrUniversity",
            "name": school.name,
            "address": { "@type": "PostalAddress", "addressCountry": school.country },
          })),
          "memberOf": SITE_CONFIG.memberOf.map(org => ({
            "@type": "Organization",
            "name": org.name,
            "url": org.url,
          })),
          "knowsAbout": SITE_CONFIG.expertise,
          "hasOccupation": {
            "@type": "Occupation",
            "name": "Médico Veterinario Especialista",
          },
        },
        // ProfilePage - Solo en /sobre-pablo
        ...(isSobrePabloPage ? [{
          "@type": "ProfilePage",
          "@id": `${SITE_URL}/sobre-pablo#profilepage`,
          "mainEntity": { "@id": personId },
          "url": `${SITE_URL}/sobre-pablo`,
          "name": `Sobre ${SITE_CONFIG.fullName}`,
          "inLanguage": "es-AR",
          "isPartOf": { "@id": `${SITE_URL}#website` },
        }] : []),
        // Book - Solo en /veterinarios/libro
        ...(isLibroPage ? SITE_CONFIG.books.map((book, index) => ({
          "@type": "Book",
          "@id": `${SITE_URL}#book-${index}`,
          "name": book.name,
          "author": { "@id": personId },
          "publisher": {
            "@type": "Organization",
            "name": book.publisher,
          },
          "url": book.urls[0],
          ...(book.urls.length > 1 && { "sameAs": book.urls.slice(1) }),
        })) : []),
      ],
    })} />

    <!-- Slot para preloads y meta tags adicionales desde páginas específicas -->
    <slot name="head" />
  </head>
  <body>
    <!-- Encabezado de navegación global -->
    <Header />

    <!-- Contenido principal de cada página -->
    <main>
      <slot />
    </main>

    <!-- Pie de página global -->
    <Footer />

    <!-- Reveal on scroll — activa la clase .visible en elementos .reveal al aparecer en viewport -->
    <script>
      (function () {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      })();
    </script>
  </body>
</html>
