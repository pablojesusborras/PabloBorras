---
// pages/contacto.astro — Página de contacto con formulario multi-tab
import Layout from '../layouts/Layout.astro';
import FormularioContacto from '../components/contacto/FormularioContacto.jsx';

const VALID_TABS = ['interconsultas', 'capacitaciones', 'eventos', 'empresas'];
const tabParam = Astro.url.searchParams.get('tab') ?? '';
const initialTab = VALID_TABS.includes(tabParam) ? tabParam : 'interconsultas';
---

<Layout
  title="Contacto — Interconsultas, Capacitaciones y Eventos | Pablo Borrás"
  description="Contactá a Pablo Borrás para interconsultas clínicas veterinarias, capacitaciones, invitaciones a eventos o propuestas institucionales."
  noindex={false}
>

  <!-- Preload imágenes hero (responsive) -->
  <link slot="head" rel="preload" as="image" href="/imagenes/heros/contactodektop.webp" media="(min-width: 768px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/imagenes/heros/contactmob.webp" media="(max-width: 767px)" fetchpriority="high" />

  <!-- Hero de contacto -->
  <section
    class="page-hero relative overflow-hidden"
    style="
      background: transparent;
      display: flex;
      align-items: center;
      min-height: 65vh;
    "
  >
    <!-- Imagen de fondo responsive -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="z-index: 0;"
      aria-hidden="true"
    >
      <!-- Desktop: altura aumentada + anclada al bottom -->
      <img
        src="/imagenes/heros/contactodektop.webp"
        alt=""
        class="hidden md:block"
        style="
          position: absolute;
          left: 0;
          bottom: 0;
          height: 125%;
          width: 100%;
          object-fit: cover;
          object-position: center 30%;
          opacity: 0.88;
        "
        loading="eager"
        fetchpriority="high"
        aria-hidden="true"
      />
      <!-- Mobile: anclada arriba para revelar la cabeza completa, con excedente hacia abajo -->
      <img
        src="/imagenes/heros/contactmob.webp"
        alt=""
        class="block md:hidden object-cover"
       style="
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 115%;
  object-position: center 35%;
"
        loading="eager"
        aria-hidden="true"
      />
    </div>

    <!-- Oscurecimiento solo detrás del texto — Desktop: solo lado izquierdo -->
    <div
      class="hidden md:block absolute top-0 left-0 bottom-0 pointer-events-none"
      style="
        width: 60%;
        background: linear-gradient(to right, rgba(3,13,58,0.65) 0%, rgba(3,13,58,0.40) 45%, rgba(3,13,58,0.15) 75%, rgba(3,13,58,0) 100%);
        z-index: 1;
      "
      aria-hidden="true"
    ></div>

    <!-- Mobile: degradado vertical — transparente arriba, oscuro abajo -->
    <div
      class="block md:hidden absolute inset-0 pointer-events-none"
      style="
        background: linear-gradient(to bottom, rgba(3,13,58,0) 0%, rgba(3,13,58,0) 25%, rgba(3,13,58,0.55) 45%, rgba(3,13,58,0.82) 70%, rgba(3,13,58,0.90) 100%);
        z-index: 1;
      "
      aria-hidden="true"
    ></div>

    <!-- Patrón de puntos sutil -->
    <div
      class="dot-pattern absolute inset-0 pointer-events-none"
      style="opacity: 0.12; z-index: 2;"
      aria-hidden="true"
    ></div>

    <div class="max-w-7xl ml-0 px-4 sm:px-6 md:px-12 lg:px-20 py-16 w-full relative z-10">
      <div class="max-w-2xl relative">
        <!-- Degradado radial negro detrás del texto (solo desktop) -->
        <div
          class="hidden md:block absolute pointer-events-none"
          style="
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 140%;
            height: 140%;
            background: radial-gradient(ellipse 80% 85% at 40% 50%, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.32) 40%, rgba(0,0,0,0.12) 65%, transparent 82%);
            z-index: -1;
            filter: blur(8px);
          "
          aria-hidden="true"
        ></div>

        <!-- Badge superior -->
        <div class="inline-block mb-6 animate-fade-in-up" style="animation-delay: 0.1s;">
          <span
            class="hero-badge inline-flex items-center gap-2 text-xs font-bold uppercase px-5 py-2.5 rounded-xl backdrop-blur-md"
            style="background: rgba(255,255,255,0.15); color: white; letter-spacing: 0.1em; border: 1px solid rgba(255,255,255,0.25); text-shadow: 0 2px 12px rgba(0,0,0,0.65);"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            Contacto Directo
          </span>
        </div>

        <!-- Título con barra vertical -->
        <div class="flex items-start gap-4 mb-6 animate-fade-in-up" style="filter: drop-shadow(0 2px 10px rgba(0,0,0,0.60)); animation-delay: 0.2s;">
          <div
            class="w-1 self-stretch rounded-full mt-1 shrink-0"
            style="background: linear-gradient(to bottom, #1880c9, #5ba8e0); min-height: 56px;"
            aria-hidden="true"
          ></div>
          <h1
            class="hero-title text-4xl md:text-5xl lg:text-6xl font-bold"
            style="
              font-family: var(--font-display);
              color: white;
              line-height: 1.2;
              text-align: left;
            "
          >
            Hablemos
          </h1>
        </div>

        <p class="hero-description text-lg md:text-xl text-white/90 max-w-2xl mb-8 leading-relaxed animate-fade-in-up" style="text-shadow: 0 2px 12px rgba(0,0,0,0.65); text-align: left; animation-delay: 0.3s;">
          Cada consulta va al destino correcto. Elegí la que corresponde a tu necesidad y te respondo a la brevedad.
        </p>
      </div>
    </div>
  </section>

  <!-- Sección principal: formulario + info de contacto -->
  <section style="background: var(--color-neutral-light);" class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">

        <!-- Columna formulario (2/3) -->
        <div class="lg:col-span-2">
          <!-- React Island: tabs de contacto -->
          <FormularioContacto client:load initialTab={initialTab} />
        </div>

        <!-- Columna info directa (1/3) -->
        <div class="space-y-6">

          <!-- Tarjeta contacto directo -->
          <div
            class="bg-white rounded-2xl p-6"
            style="box-shadow: var(--shadow); border-radius: var(--radius);"
          >
            <h3
              class="text-lg font-bold mb-4"
              style="font-family: var(--font-display); color: var(--color-text);"
            >
              Contacto directo
            </h3>
            <p class="text-sm mb-2" style="color: var(--color-text-muted);">Email profesional:</p>
            <a
              href="mailto:consultas.borras@gmail.com"
              class="text-sm font-semibold block mb-5 hover:underline"
              style="color: var(--color-accent);"
            >
              consultas.borras@gmail.com
            </a>

            <p class="text-xs" style="color: var(--color-text-muted);">
              Tiempo de respuesta habitual: <strong>24 a 48 hs hábiles.</strong>
            </p>
          </div>

          <!-- Redes sociales -->
          <div
            class="bg-white rounded-2xl p-6"
            style="box-shadow: var(--shadow); border-radius: var(--radius);"
          >
            <h3
              class="text-lg font-bold mb-4"
              style="font-family: var(--font-display); color: var(--color-text);"
            >
              Redes sociales
            </h3>
            <div class="space-y-3">
              <a
                href="https://www.instagram.com/pablojborras"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-sm font-medium transition-colors hover:opacity-80"
                style="color: var(--color-text); text-decoration: none;"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E4405F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="0.5" fill="#E4405F"/>
                </svg>
                @pablojborras
              </a>
              <a
                href="https://www.youtube.com"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-sm font-medium transition-colors hover:opacity-80"
                style="color: var(--color-text); text-decoration: none;"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF0000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.97C18.88 4 12 4 12 4s-6.88 0-8.59.45A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.4a2.78 2.78 0 0 0 1.95-1.97A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
                  <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#FF0000" stroke="none"/>
                </svg>
                Canal de YouTube
              </a>
              <a
                href="https://www.linkedin.com/in/pablojborras"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-sm font-medium transition-colors hover:opacity-80"
                style="color: var(--color-text); text-decoration: none;"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A66C2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                  <rect x="2" y="9" width="4" height="12"/>
                  <circle cx="4" cy="4" r="2"/>
                </svg>
                LinkedIn profesional
              </a>
            </div>
          </div>

          <!-- Nota de privacidad -->
          <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">
            Tu información es confidencial y solo se usará para responder tu consulta. No realizamos envíos comerciales no solicitados.
          </p>

        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Fade suave hacia la siguiente sección (desktop) */
  @media (min-width: 768px) {
    .page-hero::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 32px;
      background: linear-gradient(to bottom, transparent, var(--color-neutral-light));
      z-index: 11;
      pointer-events: none;
    }
  }

  /* Mobile: altura reducida, anclar abajo y alinear a izquierda */
  @media (max-width: 767px) {
    .page-hero {
      align-items: flex-end !important;
      padding-bottom: 1.25rem !important;
      min-height: 40vh !important;
      height: auto !important;
    }
    
    .page-hero .max-w-7xl {
      margin-left: 0 !important;
      margin-right: auto !important;
    }
    
    .page-hero .hero-title,
    .page-hero .hero-description,
    .page-hero .hero-badge {
      text-align: left !important;
    }
    
    .page-hero .flex.items-start {
      justify-content: flex-start !important;
    }
    
    /* Título: escalado continuo, sin saltos entre breakpoints */
    .page-hero .hero-title {
      font-size: clamp(1.65rem, 8vw, 2.1rem) !important;
      line-height: 1.24 !important;
    }
    
    /* Descripción: escalado continuo, legible desde 370px */
    .page-hero .hero-description {
      font-size: clamp(0.9rem, 3.8vw, 1rem) !important;
      line-height: 1.6 !important;
      margin-bottom: 0.25rem !important;
    }
    
    /* Badge más pequeño y con fondo opaco para despegarlo de la foto */
    .page-hero .hero-badge {
      font-size: 0.65rem !important;
      padding: 0.4rem 0.85rem !important;
      letter-spacing: 0.08em !important;
      background: rgba(3,13,58,0.78) !important;
      border-color: rgba(255,255,255,0.35) !important;
    }
    
    /* Sombras más fuertes para contraste */
    .page-hero .hero-title,
    .page-hero .hero-description,
    .page-hero .hero-badge {
      text-shadow: 0 1px 3px rgba(0,0,0,0.85), 0 2px 14px rgba(0,0,0,0.6) !important;
    }
    
    /* Drop-shadow más fuerte en el contenedor del título */
    .page-hero .flex.items-start {
      filter: drop-shadow(0 2px 12px rgba(0,0,0,0.70)) !important;
    }
  }
  
  /* Mobile: ajustes adicionales para pantallas pequeñas */
  @media (max-width: 380px) {
    .page-hero {
      padding-bottom: 2rem !important;
    }
    
    .page-hero h1 {
      font-size: 1.75rem !important;
    }
    
    .page-hero p {
      font-size: 0.9rem !important;
    }
  }

  /* Animaciones de entrada */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out forwards;
    opacity: 0;
  }
</style>
