---
// pages/eventos.astro — Agenda completa de eventos
import Layout from '../layouts/Layout.astro';
import AgendaEventos from '../components/eventos/AgendaEventos.astro';
---

<Layout
  title="Congresos y eventos veterinarios — Pablo Borrás Speaker Internacional"
  description="Agenda de participación de Pablo Borrás en congresos veterinarios nacionales e internacionales. ECVIM, WAAVP, AVEACA y más. Solicitar invitación como ponente."
>
  <!-- Preload imágenes hero responsive -->
  <link slot="head" rel="preload" as="image" href="/imagenes/heros/paraeven1.webp" media="(min-width: 768px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/imagenes/heros/paraeven1mob.webp" media="(max-width: 767px)" fetchpriority="high" />

  <!-- Hero mejorado -->
  <section
    class="page-hero relative overflow-hidden"
    style="
      display: flex;
      align-items: center;
    "
  >
    <!-- Imagen de fondo responsive -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="z-index: 0;"
      aria-hidden="true"
    >
      <!-- Desktop: altura aumentada + anclada al bottom para mostrar a Pablo completo -->
      <img
        src="/imagenes/heros/paraeven1.webp"
        alt=""
        class="hidden md:block"
        style="
          position: absolute;
          left: 0;
          bottom: 0;
          height: 100%;
          width: 100%;
          object-fit: cover;
          object-position: center bottom;
          opacity: 0.85;
        "
        loading="eager"
        fetchpriority="high"
        aria-hidden="true"
      />
      <!-- Mobile -->
      <img
        src="/imagenes/heros/paraeven1mob.webp"
        alt=""
        class="block md:hidden w-full h-full object-cover"
        style="object-position: center 65%;"
        loading="eager"
        aria-hidden="true"
      />
    </div>

    <!-- Oscurecimiento solo detrás del texto — Desktop: solo lado izquierdo (reforzado para opacar el slide proyectado) -->
    <div
      class="hidden md:block absolute top-0 left-0 bottom-0 pointer-events-none"
      style="
        width: 70%;
        background: linear-gradient(to right, rgba(3,13,58,0.82) 0%, rgba(3,13,58,0.68) 35%, rgba(3,13,58,0.48) 55%, rgba(3,13,58,0.22) 75%, rgba(3,13,58,0) 100%);
        z-index: 1;
      "
      aria-hidden="true"
    ></div>

    <!-- Mobile: degradado vertical — transparente arriba, oscuro abajo -->
    <div
      class="block md:hidden absolute inset-0 pointer-events-none"
      style="
        background: linear-gradient(to bottom, rgba(3,13,58,0) 0%, rgba(3,13,58,0) 25%, rgba(3,13,58,0.55) 45%, rgba(3,13,58,0.82) 70%, rgba(3,13,58,0.90) 100%);
        z-index: 1;
      "
      aria-hidden="true"
    ></div>

    <!-- Patrón de puntos sutil -->
    <div
      class="dot-pattern absolute inset-0 pointer-events-none"
      style="opacity: 0.12; z-index: 2;"
      aria-hidden="true"
    ></div>

    <div class="max-w-7xl ml-0 px-4 sm:px-6 md:px-12 lg:px-20 py-10 w-full relative z-10">
      <div class="max-w-2xl relative">
        <!-- Degradado radial negro detrás del texto (solo desktop, reforzado para separar del slide proyectado) -->
        <div
          class="hidden md:block absolute pointer-events-none"
          style="
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 140%;
            height: 140%;
            background: radial-gradient(ellipse 80% 85% at 40% 50%, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.48) 40%, rgba(0,0,0,0.20) 65%, transparent 82%);
            z-index: -1;
            filter: blur(12px);
          "
          aria-hidden="true"
        ></div>

        <!-- Badge superior mejorado -->
        <div class="inline-block mb-6">
          <span
            class="hero-badge inline-flex items-center gap-2 text-xs font-bold uppercase px-5 py-2.5 rounded-xl backdrop-blur-md"
            style="background: rgba(255,255,255,0.15); color: white; letter-spacing: 0.1em; border: 1px solid rgba(255,255,255,0.25); text-shadow: 0 2px 12px rgba(0,0,0,0.65);"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            Speaker Internacional
          </span>
        </div>

        <!-- Título con barra vertical -->
        <div class="flex items-start gap-4 mb-6" style="filter: drop-shadow(0 2px 10px rgba(0,0,0,0.60));">
          <div
            class="w-1 self-stretch rounded-full mt-1 shrink-0"
            style="background: linear-gradient(to bottom, #1880c9, #5ba8e0); min-height: 56px;"
            aria-hidden="true"
          ></div>
          <h1
            class="hero-title text-4xl md:text-5xl lg:text-6xl font-bold"
            style="
              font-family: var(--font-display);
              background: linear-gradient(135deg, #ffffff 0%, #93c5fd 100%);
              -webkit-background-clip: text;
              -webkit-text-fill-color: transparent;
              background-clip: text;
              line-height: 1.2;
              text-align: left;
            "
          >
            Agenda de eventos
          </h1>
        </div>

        <p class="hero-description text-lg md:text-xl text-white/90 max-w-3xl mb-12 leading-relaxed" style="text-shadow: 0 2px 12px rgba(0,0,0,0.65); text-align: left;">
          Congresos, jornadas, workshops y simposios donde Pablo Borrás participa como speaker, trainer o panelista a nivel nacional e internacional.
        </p>

        <!-- Stats pills -->
        <div class="hero-chips flex flex-wrap md:flex-nowrap gap-4 mb-10 items-stretch">
          <div
            class="hero-chip flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md md:flex-1 md:min-w-0"
            style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); text-shadow: 0 2px 12px rgba(0,0,0,0.65); min-height: 60px;"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
            <div class="min-w-0">
              <p class="text-xs text-white/70 uppercase tracking-wider">Participación</p>
              <p class="text-sm font-bold text-white">Congresos internacionales</p>
            </div>
          </div>

          <div
            class="hero-chip flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md md:flex-1 md:min-w-0"
            style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); text-shadow: 0 2px 12px rgba(0,0,0,0.65); min-height: 60px;"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <div class="min-w-0">
              <p class="text-xs text-white/70 uppercase tracking-wider">Formatos</p>
              <p class="text-sm font-bold text-white">Keynotes y workshops</p>
            </div>
          </div>

          <div
            class="hero-chip flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md md:flex-1 md:min-w-0"
            style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); text-shadow: 0 2px 12px rgba(0,0,0,0.65); min-height: 60px;"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
            <div class="min-w-0">
              <p class="text-xs text-white/70 uppercase tracking-wider">Temáticas</p>
              <p class="text-sm font-bold text-white">Infectología y parasitología</p>
            </div>
          </div>
        </div>

        <!-- CTA principal del hero -->
        <div class="hero-buttons flex flex-wrap gap-4">
        <a
          href="#agenda"
          class="hero-btn-primary inline-flex items-center gap-3 px-8 py-4 text-base font-bold rounded-xl transition-all"
          style="
            background: linear-gradient(135deg, #1880c9 0%, #4a3d9e 100%);
            color: white;
            text-decoration: none;
            box-shadow: 0 4px 24px rgba(24,128,201,0.4);
          "
          onmouseover="this.style.transform='translateY(-3px) scale(1.02)'; this.style.boxShadow='0 12px 36px rgba(24,128,201,0.5)'"
          onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 24px rgba(24,128,201,0.4)'"
        >
          Ver próximos eventos
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>

          <a
            href="/contacto?tab=eventos"
            class="hero-btn-secondary inline-flex items-center gap-3 px-8 py-4 text-base font-bold rounded-xl backdrop-blur-md transition-all"
            style="
              background: rgba(255,255,255,0.15);
              color: white;
              text-decoration: none;
              border: 2px solid rgba(255,255,255,0.3);
              text-shadow: 0 2px 12px rgba(0,0,0,0.65);
            "
            onmouseover="this.style.background='rgba(255,255,255,0.25)'; this.style.transform='scale(1.02)'"
            onmouseout="this.style.background='rgba(255,255,255,0.15)'; this.style.transform='scale(1)'"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            Invitar a tu evento
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Agenda completa (timeline) -->
  <AgendaEventos />

</Layout>

<style>
  /* Fade suave hacia la siguiente sección (desktop) */
  @media (min-width: 768px) {
    .page-hero::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 32px;
      background: linear-gradient(to bottom, transparent, var(--color-neutral-light));
      z-index: 11;
      pointer-events: none;
    }
  }

  /* Mobile: altura adaptativa, anclar abajo y alinear a izquierda */
  @media (max-width: 767px) {
    .page-hero {
      align-items: flex-end !important;
      padding-bottom: 2rem !important;
      min-height: auto !important;
      height: auto !important;
    }
    
    .page-hero .max-w-7xl {
      margin-left: 0 !important;
      margin-right: auto !important;
    }
    
    .page-hero .hero-title,
    .page-hero .hero-description,
    .page-hero .hero-badge {
      text-align: left !important;
    }
    
    /* Título: escalado continuo, sin saltos entre breakpoints */
    .page-hero .hero-title {
      font-size: clamp(1.65rem, 8vw, 2.1rem) !important;
      line-height: 1.24 !important;
    }
    
    /* Descripción: escalado continuo, legible desde 370px */
    .page-hero .hero-description {
      font-size: clamp(0.9rem, 3.8vw, 1rem) !important;
      line-height: 1.6 !important;
      margin-bottom: 1.5rem !important;
    }
    
    /* Badge más pequeño */
    .page-hero .hero-badge {
      font-size: 0.65rem !important;
      padding: 0.4rem 0.85rem !important;
      letter-spacing: 0.08em !important;
    }

    /* Ritmo vertical más compacto entre badge, título y credenciales */
    .page-hero .inline-block.mb-6 {
      margin-bottom: 1rem !important;
    }

    .page-hero .flex.items-start.gap-4.mb-6 {
      margin-bottom: 1rem !important;
    }
    
    /* Sombras más fuertes para contraste */
    .page-hero .hero-title,
    .page-hero .hero-description,
    .page-hero .hero-badge {
      text-shadow: 0 1px 3px rgba(0,0,0,0.85), 0 2px 14px rgba(0,0,0,0.6) !important;
    }
    
    /* Drop-shadow más fuerte en el contenedor del título */
    .page-hero .flex.items-start {
      filter: drop-shadow(0 2px 12px rgba(0,0,0,0.70)) !important;
    }
    
    /* Título en blanco sólido (sin gradiente) */
    .hero-title {
      background: none !important;
      -webkit-background-clip: initial !important;
      background-clip: initial !important;
      -webkit-text-fill-color: white !important;
      color: white !important;
    }
    
    /* Pills apiladas en columna con fondo opaco */
    .hero-chips {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 0.75rem !important;
      margin-bottom: 1.5rem !important;
    }
    
    .hero-chip {
      background: rgba(3,13,58,0.75) !important;
      border-color: rgba(255,255,255,0.3) !important;
      font-size: 0.75rem !important;
      padding: 0.65rem 1rem !important;
      width: auto !important;
      min-height: auto !important;
    }
    
    .hero-chip p {
      font-size: 0.7rem !important;
    }
    
    .hero-chip svg {
      width: 16px !important;
      height: 16px !important;
    }
    
    /* Botones apilados en columna, ancho completo */
    .hero-buttons {
      flex-direction: column !important;
      gap: 0.75rem !important;
      width: 100% !important;
    }
    
    .hero-btn-primary,
    .hero-btn-secondary {
      width: 100% !important;
      justify-content: center !important;
    }
    
    /* Botón secundario con fondo opaco */
    .hero-btn-secondary {
      background: rgba(3,13,58,0.70) !important;
    }
  }
  
  /* Aire proporcionado abajo en pantallas de 380px o menos */
  @media (max-width: 380px) {
    .page-hero {
      padding-bottom: 1.5rem !important;
    }
  }
</style>
