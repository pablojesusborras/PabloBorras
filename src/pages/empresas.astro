---
// pages/empresas.astro — Página para empresas e instituciones
import Layout from '../layouts/Layout.astro';
import ServiciosEmpresas from '../components/empresas/ServiciosEmpresas.astro';
import FormularioContacto from '../components/contacto/FormularioContacto.jsx';
---

<Layout
  title="Charlas y capacitaciones para empresas veterinarias — Pablo Borrás"
  description="Charlas institucionales, capacitaciones corporativas y colaboraciones científicas con Pablo Borrás, speaker veterinario internacional especializado en infectología y parasitología."
  heroImage="/imagenes/heros/paraempre2desktop.webp"
>
  <!-- Preload imágenes hero responsive -->
  <link slot="head" rel="preload" as="image" href="/imagenes/heros/paraempre2desktop.webp" media="(min-width: 768px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/imagenes/heros/paraempre2mobile.webp" media="(max-width: 767px)" fetchpriority="high" />

  <!-- Hero mejorado -->
  <section
    class="page-hero relative overflow-hidden"
    style="
      display: flex;
      align-items: center;
    "
  >
    <!-- Imagen de fondo responsive -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="z-index: 0;"
      aria-hidden="true"
    >
      <!-- Desktop -->
      <img
        src="/imagenes/heros/paraempre2desktop.webp"
        alt=""
        class="hidden md:block w-full h-full object-cover"
        style="object-position: center top; opacity: 0.88;"
        loading="eager"
        fetchpriority="high"
        aria-hidden="true"
      />
      <!-- Mobile -->
      <img
        src="/imagenes/heros/paraempre2mobile.webp"
        alt=""
        class="block md:hidden w-full h-full object-cover"
        style="object-position: 60% top; opacity: 0.80;"
        loading="eager"
        aria-hidden="true"
      />
    </div>

    <!-- Oscurecimiento solo detrás del texto — Desktop: solo lado izquierdo (MÁS intenso que otros héroes por fondo muy ruidoso) -->
    <div
      class="hidden md:block absolute top-0 left-0 bottom-0 pointer-events-none"
      style="
        width: 54%;
        background: linear-gradient(to right, rgba(3,13,58,0.88) 0%, rgba(3,13,58,0.62) 42%, rgba(3,13,58,0.2) 72%, rgba(3,13,58,0) 100%);
        z-index: 1;
      "
      aria-hidden="true"
    ></div>

    <!-- Mobile: degradado vertical — transparente arriba, muy oscuro abajo por fondo saturado -->
    <div
      class="block md:hidden absolute inset-0 pointer-events-none"
      style="
        background: linear-gradient(to bottom, rgba(3,13,58,0) 0%, rgba(3,13,58,0) 25%, rgba(3,13,58,0.58) 45%, rgba(3,13,58,0.85) 70%, rgba(3,13,58,0.93) 100%);
        z-index: 1;
      "
      aria-hidden="true"
    ></div>

    <!-- Patrón de puntos sutil -->
    <div
      class="dot-pattern absolute inset-0 pointer-events-none"
      style="opacity: 0.10; z-index: 2;"
      aria-hidden="true"
    ></div>

    <div class="max-w-7xl ml-0 px-4 sm:px-6 md:px-12 lg:px-20 py-10 w-full relative z-10">
      <div class="max-w-2xl relative">
        <!-- Degradado radial negro detrás del texto (solo desktop, MÁS intenso que otros héroes) -->
        <div
          class="hidden md:block absolute pointer-events-none"
          style="
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 140%;
            height: 140%;
            background: radial-gradient(ellipse 80% 85% at 40% 50%, rgba(0,0,0,0.68) 0%, rgba(0,0,0,0.42) 40%, rgba(0,0,0,0.18) 65%, transparent 82%);
            z-index: -1;
            filter: blur(12px);
          "
          aria-hidden="true"
        ></div>

        <!-- Badge superior mejorado -->
        <div class="inline-block mb-6">
          <span
            class="hero-badge inline-flex items-center gap-2 text-xs font-bold uppercase px-5 py-2.5 rounded-xl backdrop-blur-md"
            style="background: rgba(255,255,255,0.15); color: white; letter-spacing: 0.1em; border: 1px solid rgba(255,255,255,0.25); text-shadow: 0 2px 12px rgba(0,0,0,0.65);"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
            <span class="hidden md:inline">Propuestas para el sector corporativo</span>
            <span class="md:hidden">Sector corporativo</span>
          </span>
        </div>

        <!-- Título con barra vertical -->
        <div class="flex items-start gap-4 mb-6" style="filter: drop-shadow(0 2px 12px rgba(0,0,0,0.65));">
          <div
            class="w-1 self-stretch rounded-full mt-1 shrink-0"
            style="background: linear-gradient(to bottom, #1880c9, #5ba8e0); min-height: 56px;"
            aria-hidden="true"
          ></div>
          <h1
            class="hero-title text-4xl md:text-5xl lg:text-6xl font-bold"
            style="
              font-family: var(--font-display);
              background: linear-gradient(135deg, #ffffff 0%, #93c5fd 100%);
              -webkit-background-clip: text;
              -webkit-text-fill-color: transparent;
              background-clip: text;
              line-height: 1.2;
              text-align: left;
            "
          >
            Para empresas e instituciones
          </h1>
        </div>

        <p class="hero-description text-lg md:text-xl text-white/90 max-w-3xl mb-12 leading-relaxed" style="text-shadow: 0 2px 12px rgba(0,0,0,0.65); text-align: left;">
          Sumá autoridad científica, experiencia clínica y capacidad de comunicación a tus proyectos institucionales y eventos corporativos.
        </p>

        <!-- Stats pills -->
        <div class="hero-chips flex flex-wrap gap-4 mb-10">
          <div
            class="hero-chip flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
            style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); text-shadow: 0 2px 12px rgba(0,0,0,0.65); min-height: 60px;"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <div class="whitespace-nowrap">
              <p class="text-xs text-white/70 uppercase tracking-wider">Speaker</p>
              <p class="text-sm font-bold text-white">Internacional</p>
            </div>
          </div>

          <div
            class="hero-chip flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
            style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); text-shadow: 0 2px 12px rgba(0,0,0,0.65); min-height: 60px;"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            <div class="whitespace-nowrap">
              <p class="text-xs text-white/70 uppercase tracking-wider">Base</p>
              <p class="text-sm font-bold text-white">Científica sólida</p>
            </div>
          </div>

          <div
            class="hero-chip flex items-center gap-3 px-5 py-3 rounded-xl backdrop-blur-md"
            style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); text-shadow: 0 2px 12px rgba(0,0,0,0.65); min-height: 60px;"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <div class="whitespace-nowrap">
              <p class="text-xs text-white/70 uppercase tracking-wider">Experiencia</p>
              <p class="text-sm font-bold text-white">Clínica diaria</p>
            </div>
          </div>
        </div>

        <!-- CTA principal del hero -->
        <div class="hero-buttons flex flex-wrap gap-4">
        <a
          href="#servicios"
          class="hero-btn-primary inline-flex items-center gap-3 px-8 py-4 text-base font-bold rounded-xl transition-all"
          style="
            background: linear-gradient(135deg, #1880c9 0%, #4a3d9e 100%);
            color: white;
            text-decoration: none;
            box-shadow: 0 4px 24px rgba(24,128,201,0.4);
          "
          onmouseover="this.style.transform='translateY(-3px) scale(1.02)'; this.style.boxShadow='0 12px 36px rgba(24,128,201,0.5)'"
          onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 24px rgba(24,128,201,0.4)'"
        >
          Ver servicios
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>

          <a
            href="/contacto?tab=empresas"
            class="hero-btn-secondary inline-flex items-center gap-3 px-8 py-4 text-base font-bold rounded-xl backdrop-blur-md transition-all"
            style="
              background: rgba(255,255,255,0.15);
              color: white;
              text-decoration: none;
              border: 2px solid rgba(255,255,255,0.3);
              text-shadow: 0 2px 12px rgba(0,0,0,0.65);
            "
            onmouseover="this.style.background='rgba(255,255,255,0.25)'; this.style.transform='scale(1.02)'"
            onmouseout="this.style.background='rgba(255,255,255,0.15)'; this.style.transform='scale(1)'"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            Contactar
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios corporativos -->
  <ServiciosEmpresas />

  <!-- Sección: Por qué trabajar con Pablo -->
  <section class="py-16 md:py-20" style="background: linear-gradient(135deg, #040d4e 0%, #1880c9 100%);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Título de sección -->
      <div class="text-center mb-10 md:mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: rgba(255,255,255,0.8); letter-spacing: 0.12em;">
          Valor agregado
        </p>
        <h2 
          class="text-3xl md:text-4xl font-bold mb-4"
          style="
            font-family: var(--font-display);
            background: linear-gradient(135deg, #ffffff 0%, #93c5fd 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1.2;
          "
        >
          ¿Por qué trabajar con Pablo?
        </h2>
        <div class="w-20 h-1 mx-auto rounded-full" style="background: linear-gradient(90deg, #93c5fd 0%, #ffffff 100%);"></div>
      </div>

      <!-- Grid de beneficios + estadística, unificados como tarjetas -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-5 md:gap-6 items-stretch">

        <!-- Beneficio 1 -->
        <div class="text-center p-6 md:p-7 rounded-2xl h-full" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5" style="background: rgba(255,255,255,0.12); border: 2px solid rgba(255,255,255,0.2);">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-3" style="font-family: var(--font-display);">
            Experiencia clínica real
          </h3>
          <p class="text-white/80 text-sm leading-relaxed">
            Más de 15 años atendiendo pacientes a diario. Casos reales, protocolos probados, evidencia aplicable.
          </p>
        </div>

        <!-- Beneficio 2 -->
        <div class="text-center p-6 md:p-7 rounded-2xl h-full" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5" style="background: rgba(255,255,255,0.12); border: 2px solid rgba(255,255,255,0.2);">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-3" style="font-family: var(--font-display);">
            Rigor científico internacional
          </h3>
          <p class="text-white/80 text-sm leading-relaxed">
            Publicaciones en revistas indexadas. Actualización permanente con las últimas investigaciones.
          </p>
        </div>

        <!-- Beneficio 3 -->
        <div class="text-center p-6 md:p-7 rounded-2xl h-full" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5" style="background: rgba(255,255,255,0.12); border: 2px solid rgba(255,255,255,0.2);">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-3" style="font-family: var(--font-display);">
            Comunicación efectiva
          </h3>
          <p class="text-white/80 text-sm leading-relaxed">
            Speaker en congresos internacionales. Capacidad de adaptar contenido complejo para diferentes audiencias.
          </p>
        </div>

        <!-- Estadística destacada, integrada como cuarta tarjeta -->
        <div class="text-center p-6 md:p-7 rounded-2xl h-full flex flex-col items-center justify-center" style="background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.3);">
          <p class="text-4xl md:text-5xl font-bold text-white mb-2" style="font-family: var(--font-display);">
            15+ años
          </p>
          <p class="text-white/80 text-xs uppercase tracking-wider leading-relaxed">
            Combinando clínica, investigación y docencia
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Formulario pre-abierto en tab Empresas -->
  <section class="py-16 md:py-20" style="background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
          Próximo paso
        </p>
        <h2
          class="text-3xl md:text-4xl font-bold mb-4"
          style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;"
        >
          Hablemos de tu proyecto
        </h2>
        <div class="w-20 h-1 mx-auto rounded-full" style="background: linear-gradient(90deg, #1880c9 0%, #4a3d9e 100%);"></div>
        <p class="mt-4 text-base" style="color: var(--color-text-muted);">
          Contanos sobre tu empresa o institución y cómo podría colaborar Pablo.
        </p>
      </div>
      <div class="bg-white p-6 md:p-8 rounded-2xl" style="box-shadow: 0 4px 24px rgba(0,0,0,0.08); border-top: 4px solid #1880c9;">
        <FormularioContacto client:load />
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Fade suave hacia la siguiente sección (desktop) */
  @media (min-width: 768px) {
    .page-hero::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 32px;
      background: linear-gradient(to bottom, transparent, var(--color-primary));
      z-index: 11;
      pointer-events: none;
    }
  }

  /* Mobile: altura adaptativa, anclar abajo y alinear a izquierda */
  @media (max-width: 767px) {
    .page-hero {
      align-items: flex-end !important;
      padding-bottom: 2.5rem !important;
      min-height: auto !important;
      height: auto !important;
    }
    
    .page-hero .max-w-7xl {
      margin-left: 0 !important;
      margin-right: auto !important;
    }
    
    .page-hero .hero-title,
    .page-hero .hero-description,
    .page-hero .hero-badge {
      text-align: left !important;
    }
    
    /* Título: escalado continuo, sin saltos entre breakpoints */
    .page-hero .hero-title {
      font-size: clamp(1.65rem, 8vw, 2.1rem) !important;
      line-height: 1.24 !important;
    }
    
    /* Descripción: escalado continuo, legible desde 370px */
    .page-hero .hero-description {
      font-size: clamp(0.9rem, 3.8vw, 1rem) !important;
      line-height: 1.6 !important;
      margin-bottom: 1.5rem !important;
    }
    
    /* Badge más pequeño */
    .page-hero .hero-badge {
      font-size: 0.65rem !important;
      padding: 0.4rem 0.85rem !important;
      letter-spacing: 0.08em !important;
    }
    
    /* Sombras más fuertes para contraste */
    .page-hero .hero-title,
    .page-hero .hero-description,
    .page-hero .hero-badge {
      text-shadow: 0 1px 3px rgba(0,0,0,0.85), 0 2px 14px rgba(0,0,0,0.6) !important;
    }
    
    /* Drop-shadow más fuerte en el contenedor del título */
    .page-hero .flex.items-start {
      filter: drop-shadow(0 2px 12px rgba(0,0,0,0.70)) !important;
    }
    
    /* Título en blanco sólido (sin gradiente) */
    .hero-title {
      background: none !important;
      -webkit-background-clip: initial !important;
      background-clip: initial !important;
      -webkit-text-fill-color: white !important;
      color: white !important;
    }
    
    /* Pills apiladas en columna con fondo opaco */
    .hero-chips {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 0.75rem !important;
      margin-bottom: 1.5rem !important;
    }
    
    .hero-chip {
      background: rgba(3,13,58,0.75) !important;
      border-color: rgba(255,255,255,0.3) !important;
      font-size: 0.75rem !important;
      padding: 0.65rem 1rem !important;
      width: auto !important;
      min-height: auto !important;
    }
    
    .hero-chip p {
      font-size: 0.7rem !important;
    }
    
    .hero-chip svg {
      width: 16px !important;
      height: 16px !important;
    }
    
    /* Botones apilados en columna, ancho completo */
    .hero-buttons {
      flex-direction: column !important;
      gap: 0.75rem !important;
      width: 100% !important;
    }
    
    .hero-btn-primary,
    .hero-btn-secondary {
      width: 100% !important;
      justify-content: center !important;
    }
    
    /* Botón secundario con fondo opaco */
    .hero-btn-secondary {
      background: rgba(3,13,58,0.70) !important;
    }
  }
  
  /* Aire proporcionado abajo en pantallas de 380px o menos */
  @media (max-width: 380px) {
    .page-hero {
      padding-bottom: 2rem !important;
    }
  }
</style>

<script>
  if (typeof window !== 'undefined' && !new URLSearchParams(window.location.search).get('tab')) {
    const url = new URL(window.location.href);
    url.searchParams.set('tab', 'empresas');
    window.history.replaceState({}, '', url.toString());
  }
</script>
