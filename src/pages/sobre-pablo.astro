---
// pages/sobre-pablo.astro — Página completa "Acerca de Pablo Borrás"
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';

const formacion = [
  {
    año: '2005–2011',
    titulo: 'Médico Veterinario',
    institucion: 'Universidad de Buenos Aires (UBA)',
    descripcion: 'Facultad de Ciencias Veterinarias. Formación de grado con orientación en clínica de pequeños animales.',
  },
  {
    año: '2013–2016',
    titulo: 'Especialista en Enfermedades Infecciosas y Parasitarias',
    institucion: 'CPHV — Centro Profesional de Herrmienta Veterinaria',
    descripcion: 'Especialización con foco en infectología y parasitología clínica canina y felina.',
  },
  {
    año: '2017–2020',
    titulo: 'Magíster en Prevención y Control de Zoonosis',
    institucion: 'UNNOBA – ANLIS',
    descripcion: 'Maestría conjunta entre la Universidad Nacional del Noroeste de la Provincia de Buenos Aires y el ANLIS. Enfoque en epidemiología, salud pública veterinaria y enfermedades zoonóticas.',
  },
  {
    año: '2024–Actualidad',
    titulo: 'Máster en Medicina Interna de Pequeños Animales',
    institucion: 'Universidad Autónoma de Barcelona (España)',
    descripcion: 'Formación de posgrado en medicina interna avanzada. Cursando actualmente con modalidad internacional.',
  },
];

const ciencia = [
  {
    icono: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    titulo: 'Editor asociado',
    detalle: 'Parasites & Vectors — Springer Nature',
    descripcion: 'Revista científica internacional de referencia en parasitología y enfermedades vectoriales.',
  },
  {
    icono: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    titulo: 'ABCD Cats & Vets Europe',
    detalle: 'Colaborador científico',
    descripcion: 'Plataforma europea de guías de vacunación y manejo de enfermedades infecciosas felinas basadas en evidencia.',
  },
  {
    icono: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6"/><path d="M9 12h6"/><path d="M9 15h4"/></svg>`,
    titulo: 'ISCAID',
    detalle: 'Miembro activo',
    descripcion: 'International Society for Companion Animal Infectious Diseases. Red internacional de infectólogos de pequeños animales.',
  },
  {
    icono: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    titulo: 'Hospital Francisco J. Muñiz',
    detalle: 'Colaborador — Servicio de Zoopatología',
    descripcion: 'Colaboración activa con el principal hospital de enfermedades infecto-contagiosas de Argentina.',
  },
  {
    icono: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"/><path d="M15 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/><path d="M12 22v-3"/></svg>`,
    titulo: '2° Premio AVEACA 2025',
    detalle: 'Mejor caso clínico — Buenos Aires',
    descripcion: 'Primer reporte de Schizophyllum commune en perro en América Latina. Caso de osteomielitis micótica diseminada.',
  },
];

const congresos = [
  { pais: 'Argentina',       foto: '/imagenes/congresos/aveaca-buenos-aires-2025.webp',    nombre: 'AVEACA 2025 — Buenos Aires' },
  { pais: 'Colombia',        foto: '/imagenes/congresos/medellin-colombia-2025.webp',       nombre: 'Congreso Internacional — Medellín' },
  { pais: 'Ecuador',         foto: '/imagenes/congresos/cvdl-guayaquil-2025.webp',          nombre: 'CVDL — Guayaquil' },
  { pais: 'Paraguay',        foto: '/imagenes/congresos/idexx-asuncion-2025.webp',          nombre: 'IDEXX Speaker — Asunción' },
  { pais: 'Brasil',          foto: '/imagenes/congresos/waavp-curitiba-2025.webp',          nombre: 'WAAVP — Curitiba' },
  { pais: 'Países Bajos',    foto: '/imagenes/congresos/ecvim-maastricht-2025.webp',        nombre: 'ECVIM-CA — Maastricht' },
  { pais: 'Argentina',       foto: '/imagenes/congresos/civi-iguazu-2025.webp',             nombre: 'CIVI — Puerto Iguazú' },
  { pais: 'Argentina',       foto: '/imagenes/congresos/mendoza-2025.webp',                 nombre: 'Congreso Regional — Mendoza' },
];

const tematicas = [
  'Enfermedades vectoriales (Ehrlichia, Babesia, Anaplasma, Dirofilaria, Leishmania, Hepatozoon)',
  'Infectología canina y felina',
  'Zoonosis: brucelosis canina, TBC bovina en gatos, Strongyloides stercoralis',
  'Parasitología con diagnóstico molecular',
  'Moquillo canino y leptospirosis',
  'Panleucopenia felina y toxoplasmosis',
  'Dirofilariosis canina (incluyendo heat treatment)',
  'Vacunación en caninos: protocolos basados en evidencia',
];
---

<Layout
  title="Sobre Pablo Borrás — Veterinario, Speaker y Autor"
  description="Conocé en profundidad a Pablo Borrás: su trayectoria académica, actividad científica internacional, congresos en 8 países y especialización en enfermedades infecciosas y parasitarias."
>
  <!-- Preload imágenes hero responsive -->
  <link slot="head" rel="preload" as="image" href="/imagenes/heros/sobrepabl1.webp" media="(min-width: 768px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/imagenes/heros/sobrepabl1mobiel.webp" media="(max-width: 767px)" fetchpriority="high" />

  <!-- ── HERO ── -->
  <section
    class="page-hero"
    style="
      position: relative;
      display: flex;
      align-items: center;
      overflow: hidden;
      background: transparent;
    "
  >
    <!-- Imagen de fondo responsive -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="z-index: 0;"
      aria-hidden="true"
    >
      <!-- Desktop -->
      <img
        src="/imagenes/heros/sobrepabl1.webp"
        alt=""
        class="hidden md:block w-full h-full object-cover"
        style="object-position: center 20%; opacity: 0.85;"
      />
      <!-- Mobile -->
      <img
        src="/imagenes/heros/sobrepabl1mobiel.webp"
        alt=""
        class="block md:hidden w-full h-full object-cover"
        style="object-position: center 20%; opacity: 0.75;"
      />
    </div>

    <!-- Oscurecimiento solo detrás del texto — Desktop: solo lado izquierdo -->
    <div
      class="hidden md:block absolute top-0 left-0 bottom-0 pointer-events-none"
      style="
        width: 60%;
        background: linear-gradient(to right, rgba(3,13,58,0.50) 0%, rgba(3,13,58,0.30) 45%, rgba(3,13,58,0.10) 75%, rgba(3,13,58,0) 100%);
        z-index: 1;
      "
      aria-hidden="true"
    ></div>

    <!-- Mobile: gradiente vertical invertido — transparente arriba (foto nítida), oscuro abajo (texto) -->
    <div
      class="block md:hidden absolute inset-0 pointer-events-none"
      style="
        background: linear-gradient(to bottom, rgba(3,13,58,0) 0%, rgba(3,13,58,0) 25%, rgba(3,13,58,0.55) 45%, rgba(3,13,58,0.82) 70%, rgba(3,13,58,0.90) 100%);
        z-index: 1;
      "
      aria-hidden="true"
    ></div>

    <!-- Patrón de puntos sutil -->
    <div
      class="dot-pattern absolute inset-0 pointer-events-none"
      style="opacity: 0.15; z-index: 2;"
      aria-hidden="true"
    ></div>

    <div
      class="max-w-7xl ml-0 px-4 sm:px-6 md:px-12 lg:px-20 py-10 w-full"
      style="position: relative; z-index: 10;"
    >
      <div class="max-w-3xl relative">
        
        <!-- Degradado radial negro detrás del texto (solo desktop) -->
        <div
          class="hidden md:block absolute pointer-events-none"
          style="
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 140%;
            height: 140%;
            background: radial-gradient(ellipse 80% 85% at 40% 50%, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.32) 40%, rgba(0,0,0,0.12) 65%, transparent 82%);
            z-index: -1;
            filter: blur(8px);
          "
          aria-hidden="true"
        ></div>

        <!-- Línea decorativa + nombre -->
        <div class="flex items-start gap-4 mb-4" style="filter: drop-shadow(0 2px 8px rgba(0,0,0,0.45));">
          <div
            class="w-1 self-stretch rounded-full mt-1 shrink-0"
            style="background: linear-gradient(to bottom, #1880c9, #5ba8e0); min-height: 48px;"
            aria-hidden="true"
          ></div>
          <div>
            <h1
              class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.12] hero-name"
              style="
                font-family: var(--font-display);
                background: linear-gradient(135deg, #ffffff 0%, #ffffff 55%, #5ba8e0 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
              "
            >
              Pablo Borrás
            </h1>
            <p
              class="mt-2"
              style="
                color: var(--color-accent-light);
                font-family: var(--font-body);
                letter-spacing: 0.12em;
                text-transform: uppercase;
                font-size: 0.8rem;
                font-weight: 600;
                opacity: 0.9;
              "
            >
              VET. ESPECIALISTA · SPEAKER · AUTOR
            </p>
          </div>
        </div>

        <!-- Descripción -->
        <p class="text-white text-sm sm:text-base md:text-[1.05rem] leading-relaxed mb-4 max-w-lg hero-description" style="font-family: var(--font-body); letter-spacing: 0.01em; line-height: 1.75; text-shadow: 0 2px 12px rgba(0,0,0,0.65);">
          Especialista en enfermedades infecciosas y parasitarias de perros y gatos.
          Docente, investigador y voz de referencia en infectología veterinaria de habla hispana.
        </p>

        <!-- Stats inline — desktop -->
        <div
          class="hidden md:flex items-center gap-6 hero-stats"
          style="
            border-top: 1px solid rgba(255,255,255,0.15);
            border-bottom: 1px solid rgba(255,255,255,0.15);
            padding: 10px 0;
          "
        >
          <div class="text-center shrink-0">
            <p class="text-xl font-bold text-white leading-none" style="font-family: var(--font-display); text-shadow: 0 2px 12px rgba(0,0,0,0.65);">+15</p>
            <p style="font-size: 0.68rem; color: rgba(255,255,255,0.5); margin-top: 4px; font-family: var(--font-body); letter-spacing: 0.06em; text-transform: uppercase; text-shadow: 0 2px 12px rgba(0,0,0,0.65);">años</p>
          </div>
          <div style="width: 1px; height: 28px; background: rgba(255,255,255,0.12); flex-shrink: 0;"></div>
          <div class="text-center shrink-0">
            <p class="text-xl font-bold text-white leading-none" style="font-family: var(--font-display); text-shadow: 0 2px 12px rgba(0,0,0,0.65);">+15</p>
            <p style="font-size: 0.68rem; color: rgba(255,255,255,0.5); margin-top: 4px; font-family: var(--font-body); letter-spacing: 0.06em; text-transform: uppercase; text-shadow: 0 2px 12px rgba(0,0,0,0.65);">publicaciones internacionales</p>
          </div>
          <div style="width: 1px; height: 28px; background: rgba(255,255,255,0.12); flex-shrink: 0;"></div>
          <div class="text-center shrink-0">
            <p class="text-xl font-bold text-white leading-none" style="font-family: var(--font-display); text-shadow: 0 2px 12px rgba(0,0,0,0.65);">32K+</p>
            <p style="font-size: 0.68rem; color: rgba(255,255,255,0.5); margin-top: 4px; font-family: var(--font-body); letter-spacing: 0.06em; text-transform: uppercase; text-shadow: 0 2px 12px rgba(0,0,0,0.65);">seguidores</p>
          </div>
          <div style="width: 1px; height: 28px; background: rgba(255,255,255,0.12); flex-shrink: 0;"></div>
          <div class="text-center shrink-0">
            <p class="text-xl font-bold text-white leading-none" style="font-family: var(--font-display); text-shadow: 0 2px 12px rgba(0,0,0,0.65);">+8</p>
            <p style="font-size: 0.68rem; color: rgba(255,255,255,0.5); margin-top: 4px; font-family: var(--font-body); letter-spacing: 0.06em; text-transform: uppercase; text-shadow: 0 2px 12px rgba(0,0,0,0.65);">países</p>
          </div>
          <div style="width: 1px; height: 28px; background: rgba(255,255,255,0.12); flex-shrink: 0;"></div>
          <div class="text-center shrink-0">
            <p class="text-xl font-bold text-white leading-none" style="font-family: var(--font-display); text-shadow: 0 2px 12px rgba(0,0,0,0.65);">2</p>
            <p style="font-size: 0.68rem; color: rgba(255,255,255,0.5); margin-top: 4px; font-family: var(--font-body); letter-spacing: 0.06em; text-transform: uppercase; text-shadow: 0 2px 12px rgba(0,0,0,0.65);">libros</p>
          </div>
        </div>

        <!-- Stats — mobile -->
        <div class="hero-stats-mobile grid md:hidden grid-cols-5 mb-4 mt-3">
          <div class="hero-stat text-center">
            <p class="text-base font-bold text-white leading-none" style="font-family: var(--font-display);">+15</p>
            <p class="hero-stat-label">años</p>
          </div>
          <div class="hero-stat text-center">
            <p class="text-base font-bold text-white leading-none" style="font-family: var(--font-display);">+15</p>
            <p class="hero-stat-label">publ. int.</p>
          </div>
          <div class="hero-stat text-center">
            <p class="text-base font-bold text-white leading-none" style="font-family: var(--font-display);">32K+</p>
            <p class="hero-stat-label">seguidores</p>
          </div>
          <div class="hero-stat text-center">
            <p class="text-base font-bold text-white leading-none" style="font-family: var(--font-display);">+8</p>
            <p class="hero-stat-label">países</p>
          </div>
          <div class="hero-stat text-center">
            <p class="text-base font-bold text-white leading-none" style="font-family: var(--font-display);">2</p>
            <p class="hero-stat-label">libros</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <style>
    /* Animaciones de entrada escalonadas */
    .hero-name {
      opacity: 0;
      animation: fadeInUp 0.6s ease-out 0.1s both;
    }

    .hero-description {
      opacity: 0;
      animation: fadeInUp 0.6s ease-out 0.3s both;
    }

    .hero-stats,
    .hero-stats-mobile {
      opacity: 0;
      animation: fadeInUp 0.6s ease-out 0.4s both;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Stats mobile: grilla de 5 columnas */
    @media (max-width: 767px) {
      .hero-stats-mobile {
        border-top: 1px solid rgba(255,255,255,0.14);
        border-bottom: 1px solid rgba(255,255,255,0.14);
        padding: 10px 0;
        column-gap: 0.25rem;
      }

      .hero-stat-label {
        font-size: 0.55rem;
        color: rgba(255,255,255,0.58);
        margin-top: 4px;
        font-family: var(--font-body);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        line-height: 1.2;
        text-shadow: 0 1px 3px rgba(0,0,0,0.85), 0 2px 10px rgba(0,0,0,0.55);
      }

      .hero-stats-mobile .hero-stat p {
        text-shadow: 0 1px 3px rgba(0,0,0,0.85), 0 2px 10px rgba(0,0,0,0.55);
      }
    }

    /* Breakpoint adicional para pantallas muy chicas */
    @media (max-width: 380px) {
      .hero-stats-mobile .hero-stat p:first-child {
        font-size: 0.9rem !important;
      }
      .hero-stat-label {
        font-size: 0.5rem !important;
      }
    }

    /* Fade suave hacia la siguiente sección (desktop) */
    @media (min-width: 768px) {
      .page-hero::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 32px;
        background: linear-gradient(to bottom, transparent, var(--color-neutral-light));
        z-index: 11;
        pointer-events: none;
      }
    }

    /* Mobile: mantener anclaje abajo */
    @media (max-width: 767px) {
      .page-hero {
        align-items: flex-end !important;
      }
    }

  </style>

  <!-- ── BIO + FOTO ── -->
  <section class="bio-photo-section py-20" style="background: #f8fafc;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Parte superior: dos columnas alineadas al tope -->
      <div class="bio-layout grid grid-cols-1 gap-8 lg:gap-12 items-start mb-10">

        <!-- Columna izquierda: Foto + Caption -->
        <div class="bio-photo-column order-1">
          <div class="bio-photo-frame">
            <img
              src="/imagenes/perfil/pablo1.webp"
              alt="Pablo Borrás — Médico Veterinario especialista en infectología"
              class="bio-photo w-full object-cover object-top"
              width="560"
              height="560"
              loading="eager"
            />
          </div>
          <!-- Caption strip -->
          <div class="bio-credential">
            <span
              style="width: 8px; height: 8px; border-radius: 50%; background: #4ade80; flex-shrink: 0;"
              aria-hidden="true"
            ></span>
            <p class="bio-credential-text">
              Editor asociado · <em>Parasites &amp; Vectors</em> — Springer Nature
            </p>
          </div>
        </div>

        <!-- Columna derecha: Badge + Título + Párrafos -->
        <div class="bio-copy-column order-2">
          <span
            class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-3"
            style="background: rgba(24,128,201,0.1); color: var(--color-accent); border: 1px solid rgba(24,128,201,0.25);"
          >
            Quién es
          </span>

          <!-- Línea decorativa antes del título -->
          <div
            class="bio-title-accent"
            aria-hidden="true"
          ></div>

          <h2
            class="bio-section-title text-3xl md:text-4xl font-bold mb-5"
            style="font-family: var(--font-display); color: var(--color-text); line-height: 1.2;"
          >
            Una trayectoria construida sobre ciencia y compromiso
          </h2>

          <div class="bio-copy space-y-3 md:space-y-4">
            <!-- Primer párrafo: destacado con borde izquierdo -->
            <p style="
              color: #111827;
              font-weight: 600;
              font-size: 14.5px;
              line-height: 1.75;
              border-left: 3px solid #1880c9;
              padding-left: 14px;
            ">
              Pablo Borrás es Médico Veterinario egresado de la Universidad de Buenos Aires, Especialista
              en Enfermedades Infecciosas y Parasitarias (CPHV) y Magíster en Prevención y Control de
              Zoonosis (UNNOBA–ANLIS). Actualmente cursa el Máster en Medicina Interna de Pequeños
              Animales en la Universidad Autónoma de Barcelona.
            </p>

            <!-- Párrafos intermedios: secundarios -->
            <p class="bio-copy-secondary">
              A lo largo de más de 15 años de carrera, construyó un perfil único que combina la clínica
              diaria con la investigación científica, la docencia y la comunicación. Ese cruce entre
              rigor académico y capacidad de transmitir es lo que define su forma de ejercer y enseñar.
            </p>

            <p class="bio-copy-secondary">
              Ha disertado en congresos internacionales en Argentina, Colombia, Ecuador, Uruguay, Brasil,
              Paraguay, España y Países Bajos. Es colaborador del Servicio de Zoopatología del Hospital
              Francisco J. Muñiz, editor asociado de <em>Parasites & Vectors</em> (Springer Nature) y
              <!-- ABCD Cats & Vets Europe e ISCAID: consultar con la clienta si también deben sacarse, igual que TroCCAP -->
              miembro activo de ABCD Cats & Vets Europe e ISCAID.
            </p>

            <!-- Último párrafo: chip destacado con emoji -->
            <div class="bio-award">
              <p style="color: #1880c9; font-weight: 500; font-size: 13px; line-height: 1.7; margin: 0;">
                🏆 En 2025, obtuvo el 2° Premio al mejor caso clínico en AVEACA por el primer reporte de
                <em>Schizophyllum commune</em> en perro en América Latina. Ese mismo año fue speaker
                oficial del lanzamiento de SNAP Tests IDEXX en Asunción, Paraguay.
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- Parte inferior: fila completa de 4 stats -->
      <div class="bio-stats-wrap">
        <div class="stats-grid grid grid-cols-2 md:grid-cols-4">
          {[
            { n: '+15', l: 'Años de experiencia clínica', lMobile: 'Exp. clínica' },
            { n: '+32K', l: 'Seguidores en Instagram', lMobile: 'Seguidores IG' },
            { n: '+8', l: 'Países donde disertó', lMobile: 'Países' },
            { n: '+15', l: 'Publicaciones internacionales', lMobile: 'Publ. internac.' },
          ].map((s) => (
            <div
              class="stat-card"
            >
              <p
                class="stat-number text-3xl font-bold leading-none mb-2"
                style="font-family: var(--font-display); color: #1880c9;"
              >
                {s.n}
              </p>
              <p
                class="stat-label text-xs uppercase tracking-wide"
                style="color: var(--color-text-muted); font-weight: 500; letter-spacing: 0.05em;"
              >
                <span class="hidden md:inline">{s.l}</span>
                <span class="md:hidden">{s.lMobile}</span>
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <style>
    .bio-layout {
      grid-template-columns: 1fr;
    }

    .bio-photo-frame {
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border: 1px solid #d0dff0;
      border-radius: 14px;
      box-shadow: 0 12px 28px rgba(4,13,78,0.10);
