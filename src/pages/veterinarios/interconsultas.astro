---
// pages/veterinarios/interconsultas.astro — Página de interconsultas con formulario
import Layout from '../../layouts/Layout.astro';
import Interconsultas from '../../components/veterinarios/Interconsultas.astro';
import FormularioContacto from '../../components/contacto/FormularioContacto.jsx';
---

<Layout
  title="Interconsultas clínicas veterinarias — Infectología y Parasitología | Pablo Borrás"
  description="Segunda opinión especializada en enfermedades infecciosas y parasitarias en perros y gatos. Interconsultas para veterinarios con Pablo Borrás, MSc en zoonosis."
>
  <link slot="head" rel="preload" as="image" href="/imagenes/heros/mendoza.webp" fetchpriority="high" />

  <!-- Hero -->
  <section class="page-hero ic-hero relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="z-index: 0;" aria-hidden="true">
      <img
        src="/imagenes/heros/paravet1.png"
        alt=""
        class="ic-hero-img hidden md:block"
        loading="eager"
        fetchpriority="high"
        aria-hidden="true"
      />
      <img
        src="/imagenes/heros/paravet1mob.png"
        alt=""
        class="ic-hero-img-mobile block md:hidden"
        loading="eager"
        aria-hidden="true"
      />
    </div>

    <div class="ic-hero-overlay-desktop hidden md:block absolute top-0 left-0 bottom-0 pointer-events-none" aria-hidden="true"></div>
    <div class="ic-hero-overlay-mobile block md:hidden absolute inset-0 pointer-events-none" aria-hidden="true"></div>

    <div class="dot-pattern absolute inset-0 pointer-events-none" style="opacity: 0.12; z-index: 2;" aria-hidden="true"></div>

    <div class="ic-hero-inner max-w-7xl ml-0 px-4 sm:px-6 md:px-12 lg:px-20 py-16 w-full relative z-10">
      <div class="max-w-2xl relative">
        <div class="ic-hero-radial hidden md:block absolute pointer-events-none" aria-hidden="true"></div>

        <nav class="ic-hero-breadcrumb flex items-center gap-2 text-sm whitespace-nowrap" aria-label="Breadcrumb">
          <a href="/veterinarios" class="inline-flex items-center gap-1 transition-colors" style="color: #a8d8f0; text-decoration: none; font-weight: 500;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Para veterinarios
          </a>
          <span class="text-white/40">/</span>
          <span class="text-white/80 font-medium">Interconsultas</span>
        </nav>

        <div class="hero-badge inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest px-5 py-2.5 rounded-full">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
          Servicio profesional
        </div>

        <div class="flex items-start gap-4 mb-6 ic-hero-title-wrap">
          <div
            class="w-1 self-stretch rounded-full mt-1 shrink-0"
            style="background: linear-gradient(to bottom, #1880c9, #5ba8e0); min-height: 56px;"
            aria-hidden="true"
          ></div>
          <h1 class="hero-title text-4xl md:text-5xl font-bold text-white" style="font-family: var(--font-display); line-height: 1.15; text-align: left;">
            Interconsultas clínicas<br/>
            <span class="hero-title-highlight">especializadas</span>
          </h1>
        </div>

        <p class="hero-description text-white/90 text-lg md:text-xl max-w-2xl leading-relaxed mb-6">
          Segunda opinión especializada para casos complejos en enfermedades infecciosas y parasitarias. Enfoque basado en evidencia con seguimiento completo.
        </p>

        <div class="hero-chips flex flex-wrap gap-3 items-center">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            +15 años de experiencia
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
            </svg>
            Enfoque evidence-based
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            Seguimiento incluido
          </span>
        </div>
      </div>
    </div>
  </section>

  <Interconsultas />

  <section id="formulario-contacto" class="ic-form-section">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center ic-form-heading">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent); letter-spacing: 0.12em;">
          Contacto directo
        </p>
        <h2
          class="text-3xl md:text-4xl font-bold mb-4"
          style="font-family: var(--font-display); color: var(--color-text);"
        >
          Enviá tu consulta
        </h2>
        <div class="w-20 h-1 mx-auto rounded-full mb-4" style="background: linear-gradient(90deg, #1880c9 0%, #0d9488 100%);"></div>
        <p class="text-base" style="color: var(--color-text-muted);">
          Completá el formulario con los detalles del caso y te respondemos a la brevedad.
        </p>
      </div>
      <div class="ic-form-shell bg-white rounded-2xl">
        <FormularioContacto client:load />
      </div>
    </div>
  </section>

</Layout>

<script>
  if (typeof window !== 'undefined' && !new URLSearchParams(window.location.search).get('tab')) {
    const url = new URL(window.location.href);
    url.searchParams.set('tab', 'interconsultas');
    window.history.replaceState({}, '', url.toString());
  }
</script>

<style>
  .ic-hero {
    background: transparent;
    display: flex;
    align-items: center;
    min-height: 70vh;
  }

  .ic-hero-img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .ic-hero-img-mobile {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 115%;
    object-fit: cover;
    object-position: center 42%;
  }

  .ic-hero-overlay-desktop {
    width: 62%;
    background: linear-gradient(to right, rgba(3,13,58,0.72) 0%, rgba(3,13,58,0.48) 45%, rgba(3,13,58,0.18) 75%, rgba(3,13,58,0) 100%);
    z-index: 1;
  }

  .ic-hero-overlay-mobile {
    background: linear-gradient(to bottom, rgba(3,13,58,0) 0%, rgba(3,13,58,0) 28%, rgba(3,13,58,0.50) 50%, rgba(3,13,58,0.80) 75%, rgba(3,13,58,0.90) 100%);
    z-index: 1;
  }

  .ic-hero-radial {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 135%;
    height: 135%;
    background: radial-gradient(ellipse 78% 82% at 40% 50%, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.32) 40%, rgba(0,0,0,0.12) 65%, transparent 82%);
    z-index: -1;
    filter: blur(9px);
  }

  .ic-hero-breadcrumb {
    margin-bottom: 1rem;
    font-size: 0.8rem;
  }

  .hero-badge {
    background: rgba(255,255,255,0.12);
    color: #a8d8f0;
    border: 1px solid rgba(255,255,255,0.25);
    letter-spacing: 0.12em;
    backdrop-filter: blur(10px);
    text-shadow: 0 2px 12px rgba(0,0,0,0.65);
    margin-bottom: 1.25rem;
  }

  .ic-hero-title-wrap {
    filter: drop-shadow(0 2px 10px rgba(0,0,0,0.55));
  }

  .hero-title-highlight {
    background: linear-gradient(135deg, #ffffff 0%, #5ba8e0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    text-shadow: 0 2px 12px rgba(0,0,0,0.65);
    text-align: left;
  }

  .hero-chips span {
    background: rgba(255,255,255,0.15);
    color: white;
    border: 1px solid rgba(255,255,255,0.3);
    backdrop-filter: blur(10px);
    text-shadow: 0 2px 12px rgba(0,0,0,0.65);
  }

  .ic-form-section {
    background: linear-gradient(135deg, #f0f9ff 0%, #f8fafc 100%);
    padding: 3.5rem 0;
  }

  .ic-form-heading {
    margin-bottom: 2rem;
  }

  .ic-form-shell {
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    border-top: 4px solid #1880c9;
    padding: 1.25rem;
  }

  @media (min-width: 768px) {
    .page-hero::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 32px;
      background: linear-gradient(to bottom, transparent, #ffffff);
      z-index: 11;
      pointer-events: none;
    }

    .ic-form-section {
      padding: 4rem 0;
    }

    .ic-form-heading {
      margin-bottom: 2.5rem;
    }

    .ic-form-shell {
      padding: 2.5rem;
    }
  }

  @media (max-width: 767px) {
    .ic-hero {
      align-items: flex-end;
      min-height: 58vh;
      height: auto;
      padding-bottom: 2rem;
    }

    .ic-hero-inner {
      margin-left: 0;
      margin-right: auto;
      padding-top: 5rem;
      padding-bottom: 0.5rem;
    }

    .ic-hero-breadcrumb {
      font-size: 0.72rem;
      margin-bottom: 0.75rem;
    }

    .hero-badge,
    .hero-title,
    .hero-description {
      text-align: left;
    }

    .hero-title {
      font-size: clamp(1.65rem, 8vw, 2.1rem);
      line-height: 1.24;
    }

    .hero-description {
      font-size: clamp(0.9rem, 3.8vw, 1rem);
      line-height: 1.6;
      margin-bottom: 1.15rem;
    }

    .hero-badge {
      font-size: 0.65rem;
      padding: 0.4rem 0.85rem;
      letter-spacing: 0.08em;
      margin-bottom: 0.9rem;
    }

    .hero-chips {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
      margin-bottom: 0.25rem;
    }

    .hero-chips span {
      font-size: 0.7rem;
      padding: 0.5rem 0.75rem;
    }

    .hero-title,
    .hero-description,
    .hero-badge {
      text-shadow: 0 1px 3px rgba(0,0,0,0.85), 0 2px 14px rgba(0,0,0,0.6);
    }

    .ic-hero-title-wrap {
      filter: drop-shadow(0 2px 12px rgba(0,0,0,0.70));
    }

    .hero-title-highlight {
      background: none;
      -webkit-background-clip: initial;
      background-clip: initial;
      -webkit-text-fill-color: white;
      text-shadow: 0 1px 3px rgba(0,0,0,0.85), 0 2px 14px rgba(0,0,0,0.6);
    }

    .ic-form-section {
      padding: 2.75rem 0 3rem;
    }

    .ic-form-heading {
      margin-bottom: 1.5rem;
    }

    .ic-form-shell {
      padding: 1rem;
    }
  }
</style>
